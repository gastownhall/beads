load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "position",
    srcs = ["position.go"],
    importpath = "github.com/steveyegge/beads/tools/nogo/internal/position",
    visibility = ["//tools/nogo:__subpackages__"],
    deps = ["@org_golang_x_tools//go/analysis"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
