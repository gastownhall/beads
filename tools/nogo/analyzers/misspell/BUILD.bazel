load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "misspell",
    srcs = ["misspell.go"],
    importpath = "github.com/steveyegge/beads/tools/nogo/analyzers/misspell",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/nogo/internal/golangci",
        "@com_github_golangci_misspell//:misspell",
        "@org_golang_x_tools//go/analysis",
    ],
)

go_test(
    name = "misspell_test",
    srcs = ["misspell_test.go"],
    deps = [
        ":misspell",
        "//tools/nogo/internal/analyzertest",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
