load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "errcheck",
    srcs = ["errcheck.go"],
    importpath = "github.com/steveyegge/beads/tools/nogo/analyzers/errcheck",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/nogo/internal/golangci",
        "//tools/nogo/internal/position",
        "@com_github_kisielk_errcheck//errcheck",
        "@org_golang_x_tools//go/analysis",
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "errcheck_test",
    srcs = ["errcheck_test.go"],
    deps = [
        ":errcheck",
        "//tools/nogo/internal/analyzertest",
    ],
)

