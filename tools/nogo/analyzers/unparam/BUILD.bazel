load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "unparam",
    srcs = ["unparam.go"],
    importpath = "github.com/steveyegge/beads/tools/nogo/analyzers/unparam",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/nogo/internal/golangci",
        "@cc_mvdan_unparam//check",
        "@org_golang_x_tools//go/analysis",
        "@org_golang_x_tools//go/analysis/passes/buildssa",
