load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "docsmint_lib",
    srcs = [
        "docsmint.go",
        "legacy.go",
        "main.go",
    ],
    importpath = "github.com/steveyegge/beads/tools/docsmint",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "docsmint",
    embed = [":docsmint_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "docsmint_test",
    srcs = [
        "docsmint_test.go",
        "legacy_test.go",
    ],
    embed = [":docsmint_lib"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
