# The bd that subprocess tests exec, injected through BEADS_TEST_BD_BINARY
# (bazeltest.PrebuiltBD) instead of a per-package `go build`. Never race
# instrumented, even under --config=prcore: it matches the non-race
# gms_pure_go binary pr-core's tests build today. Named bd, like that binary.
go_binary(
    name = "bd_for_tests",
    out = "bd_for_tests/bd",
    embed = [":bd_lib"],
    race = "off",
    visibility = [
        "//cmd/bd:__subpackages__",
        "//internal/beads:__pkg__",
        "//internal/storage/uow:__pkg__",
        "//test/conformance:__pkg__",
    ],
)

