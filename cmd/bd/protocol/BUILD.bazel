load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:race.bzl", "go_test_race_off")

go_library(
    name = "protocol",
    srcs = ["corpus.go"],
    importpath = "github.com/steveyegge/beads/cmd/bd/protocol",
    visibility = ["//visibility:public"],
)

go_test(
    name = "protocol_test",
    srcs = [
        "assignee_test.go",
        "blocked_status_test.go",
        "blocked_test.go",
        "blocking_semantics_test.go",
        "canonicalize_test.go",
        "child_id_test.go",
        "children_test.go",
        "close_guard_test.go",
        "comments_test.go",
        "corpus_test.go",
        "defer_test.go",
        "dep_identity_test.go",
        "errors_contract_test.go",
        "exit_codes_init_test.go",
        "exit_codes_test.go",
        "helpers_test.go",
        "input_validation_test.go",
        "interchange_test.go",
        "json_contract_test.go",
        "lease_claim_test.go",
        "lifecycle_test.go",
        "memory_contract_test.go",
        "preservation_test.go",
        "ready_front_test.go",
        "roundtrip_test.go",
        "stale_test.go",
        "status_validation_test.go",
        "versioning_contract_test.go",
        "wp4_helpers_test.go",
    ],
    data = glob(["testdata/**"]) + ["//cmd/bd:bd_for_tests"],
    embed = [":protocol"],
    env = {"BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)"},
    deps = [
        "//internal/storage/schema",
        "//internal/testutil",
        "//internal/testutil/bazeltest",
    ],
)

# protocol_test without the race detector, which --config=docker otherwise
# turns on for every target: pr.yml's "Contract corpus" job runs
# `go test ./cmd/bd/protocol` without -race (PR Core covers the race build).
# Matching it is cheap: tools/bazel/race.bzl lands protocol_test's deps in
# the configuration the non-race //cmd/bd:bd_for_tests already builds them in,
# so the extra work is protocol_test's test-only libraries and one link.
# Racing it instead would also be acceptable (a race-only failure is a real
# bug); then drop this target and point protocol_docker_test back at
# :protocol_test.
#
# Tags:
#   manual: only protocol_docker_test's input, never a build target of its
#     own. `bazel test //...` in every lane still builds it through
#     protocol_docker_test (a test tag filter does not stop the build).
go_test_race_off(
    name = "protocol_race_off",
    tags = ["manual"],
    test = ":protocol_test",
)

# protocol_test as pr.yml's "Contract corpus" job runs it: non-race, TestMain
# starts a dolt sql-server container and BEADS_PROTOCOL_REQUIRE_DOLT=1 turns a
# missing container into a failure instead of a skip. It repeats
# protocol_test's `env` (go_test_variant.sh cannot inherit it). protocol_test
# itself stays untagged: under --config=prcore (BEADS_TEST_SKIP=dolt) its
# Dolt-backed tests skip.
#
# Tags:
#   requires-docker: needs a docker daemon; excluded from --config=prcore/ci,
#     selected by --config=docker.
#   no-remote-exec: the daemon is on the host, not on remote workers.
sh_test(
    name = "protocol_docker_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :protocol_race_off)"],
    data = [
        ":protocol_race_off",
        "//cmd/bd:bd_for_tests",
    ],
    # Pinned to the container backend (the docker lane is the A/B control);
    # rule env beats --test_env, so =local on the command line cannot flip it.
    env = {
        "BEADS_PROTOCOL_REQUIRE_DOLT": "1",
        "BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)",
        "BEADS_TEST_DOLT_SERVER": "container",
    },
    # ~10 min unsharded without -race in pr.yml.
    shard_count = 8,
    tags = [
        "no-remote-exec",
        "requires-docker",
    ],
)

# protocol_test as pr.yml's "Contract corpus" job runs it (non-race, like the
# job; see protocol_race_off), on the dolt-server lane: TestMain's server is a
# local `dolt sql-server` child of the test process, and
# BEADS_PROTOCOL_REQUIRE_DOLT=1 turns a server that cannot start into a
# failure, so the golden and double-run determinism tests cannot skip. It
# repeats protocol_test's `env`. protocol_docker_test is the A/B control.
#
# Tags:
#   dolt-server: starts hermetic dolt sql-servers from the pinned dolt in the
#     test wrapper's runfiles (BEADS_TEST_DOLT_SERVER=local); excluded from
#     --config=prcore/ci, selected by --config=doltserver. Runs remotely: no
#     docker, and a missing server fails (REQUIRE=1) instead of skipping, so
#     a cached pass is as good as a fresh one.
sh_test(
    name = "protocol_dolt_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :protocol_race_off)"],
    data = [
        ":protocol_race_off",
        "//cmd/bd:bd_for_tests",
    ],
    env = {
        "BEADS_PROTOCOL_REQUIRE_DOLT": "1",
        "BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)",
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        "GOMAXPROCS": "4",
    },
    shard_count = 8,
    tags = ["dolt-server"],
)
