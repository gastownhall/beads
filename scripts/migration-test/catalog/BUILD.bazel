load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "catalog_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/scripts/migration-test/catalog",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "catalog",
    embed = [":catalog_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "catalog_test",
    srcs = ["main_test.go"],
    data = ["//scripts:migration-test/release-catalog.json"],
    embed = [":catalog_lib"],
)

