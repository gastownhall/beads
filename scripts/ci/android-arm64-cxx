#!/usr/bin/env bash
# The CXX of .goreleaser.yml's bd-android-arm64 build: the pinned Android NDK's
# API-21 clang++ (see lib/android-ndk-clang.sh; android-arm64-cc is its twin).
set -euo pipefail
# shellcheck source=lib/android-ndk-clang.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/android-ndk-clang.sh"
android_ndk_exec_clang "++" "$@"
