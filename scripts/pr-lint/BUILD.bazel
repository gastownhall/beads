load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pr-lint_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/scripts/pr-lint",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "pr-lint",
    embed = [":pr-lint_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "pr-lint_test",
    srcs = ["main_test.go"],
    embed = [":pr-lint_lib"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
