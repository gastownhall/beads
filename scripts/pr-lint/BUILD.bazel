load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pr-lint_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/scripts/pr-lint",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "pr-lint",
    embed = [":pr-lint_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "pr-lint_test",
    srcs = ["main_test.go"],
    data = ["//:.buildflags"],
    embed = [":pr-lint_lib"],
    deps = ["//internal/testutil/bazeltest"],
)
