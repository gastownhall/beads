load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "prlintmake_test",
    srcs = [
        "gofmtbin_test.go",
        "prlintmake_test.go",
    ],
    data = [
        "//:.buildflags",
        "//:go.mod",
        "//scripts:ci/fmt-check.sh",
        "//scripts:ci/gofmt-bin.sh",
        "//scripts:ci/lib/timing.sh",
        "//scripts:ci/pr-lint.sh",
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
    ],
    # go.mod's toolchain is the registered SDK (scripts/bazel_policy_test.go
    # pins them together): testGo puts it first on PATH, so gofmt-bin.sh never
    # downloads a toolchain. Remote actions may have no network (rbe-fork).
    env = {"BEADS_TEST_GO": "$(rlocationpath @go_sdk//:bin/go)"},
    deps = ["//internal/testutil/bazeltest"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
