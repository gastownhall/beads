# check-testing-short.sh over every Go file, test and non-test, plus the
# Go-exec half of the host-go-under-Bazel policy (host_tool_exec_policy_test.go
# scans //:repo_go_srcs and //:repo_go_test_srcs for a literal go/gofmt exec),
# plus the Dolt host policy (dolt_host_policy_test.go scans //:repo_go_srcs
# for host spellings interpreted outside internal/configfile/dolt_host.go).
# The shell-script half (host_tool_shell_policy_test.go) is its own
# :shell_host_tool_policy_test below: it reads a fixed, narrow list of shell
# scripts, not every Go source file, so it would otherwise pay this target's
# full re-run cost for files it never looks at.
go_test(
    name = "go_sources_test",
    srcs = [
        "dolt_host_policy_test.go",
        "host_tool_exec_policy_test.go",
        "repo_helpers_test.go",
        "testing_short_tree_test.go",
