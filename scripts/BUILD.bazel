load("@rules_go//go:def.bzl", "go_test")

# CI and repo-policy tests: they parse the workflows and run the CI shell
# scripts against fixtures.
#
# Tags:
#   host-tools: the scripts and fixtures run the host's git, python3, awk,
#     sed, find, grep, timeout and GNU Make (beyond the bash the test wrapper needs).
#     Under Bazel a missing git or bash fails the test (under go test it
#     skips).
#   no-remote-exec: so they always run where that inventory is known (the
#     developer machine or the CI runner). The farm workers do have these
#     tools today (the target passes there), so this can be dropped once that
#     is guaranteed.
#   no-remote-cache: the action key does not cover the host's tools, so a
#     result from one host is neither uploaded for nor served to another.
go_test(
    name = "scripts_test",
    srcs = [
        "bazel_policy_test.go",
        "check_build_tags_test.go",
        "check_testing_short_test.go",
        "ci_capability_selector_test.go",
        "ci_workflow_apt_get_timeout_test.go",
        "ci_workflow_test.go",
        "complexity_script_test.go",
        "conformance_script_test.go",
        "host_tools_test.go",
        "install_dolt_test.go",
        "make_smoke_candidate_test.go",
        "pull_dolt_image_test.go",
        "release_script_test.go",
        "test_script_test.go",
    ],
    data = [
        ":scripts_files",
        "//:Makefile",
        "//:bazel_policy_files",
        "//:test_sh_files",
        "//:workflow_files",
        "//internal/testutil:testdoltcommon.go",
        "//tools/bazel:dolt.bzl",
    ],
    tags = [
        "host-tools",
        "no-remote-cache",
        "no-remote-exec",
    ],
    deps = [
        "//internal/formula",
        "//internal/testutil/bazeltest",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# The scripts scripts_test reads and runs (CI helpers, check-*.sh, release.sh,
# test.sh, conformance.sh, ...). Globs stop at subpackages, so this is only
# this package's own tree.
filegroup(
    name = "scripts_files",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "**/*_test.go",
        ],
    ),
)

exports_files(
    ["migration-test/release-catalog.json"],
    visibility = ["//scripts/migration-test/catalog:__pkg__"],
)

exports_files(
    ["ci/fmt-check.sh"],
    visibility = ["//scripts/prlintmake:__pkg__"],
)

exports_files(
    ["README.md"],
    visibility = ["//:__pkg__"],
)
