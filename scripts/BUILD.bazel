)

exports_files(
    ["upgrade-smoke-test.sh"],
    visibility = ["//tests/upgrade_smoke:__pkg__"],
)

exports_files(
    [
        "ci/fmt-check.sh",
        "ci/lib/timing.sh",
        "ci/pr-lint.sh",
    ],
    visibility = ["//scripts/prlintmake:__pkg__"],
)

exports_files(
    ["ci/gofmt-bin.sh"],
    visibility = ["//scripts/prlintmake:__pkg__"],
)

# The compatibility entrypoint whose exit-status contract
# //scripts/check-versions:check-versions_test drives.
exports_files(
    ["check-versions.sh"],
    visibility = ["//scripts/check-versions:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
