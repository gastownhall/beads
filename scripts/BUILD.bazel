load("@rules_go//go:def.bzl", "go_test")

# CI and repo-policy tests: they parse the workflows, run the CI shell scripts
# against fixtures, and check repository-wide rules (BUILD tag taxonomy, skip
# allowlist, managed BUILD blocks, shard manifests, tracked-file scans).
#
# They are one Go package but several go_test targets, each compiling only
# the files whose tests it runs and declaring only what those tests read, so
# that a change re-runs only the targets that read it: a Go-only change runs
# no workflow policy test, a docs-only or workflow-only change no Go-source
# scan. The data are the partitions of the checkout that tools/bazel/go_srcs.py
# generates (//:repo_go_srcs, //:repo_go_test_srcs, //:repo_doc_files,
# //:repo_other_files, and per package) or single files; only
# :tracked_files_test declares //:repo_files, every tracked file.
#
# Every *_test.go here is in exactly one of these targets, except the
# helpers-only files (no Test functions) that several compile; srcs are kept
# by hand (`# keep` stops gazelle from putting every file back into
# scripts_test), and TestScriptsTestTargetsPartitionTheTests
# (scripts_targets_test.go) fails on a file in no target or a test in two.
#
# No tags: they run remotely like any other target. The scripts and fixtures
# run bash, git, python3, jq, yq, curl, openssl, unzip and coreutils from the
# executor (the rbe-west worker image, or the runner in fork-cache mode); a
# missing tool fails the test under Bazel instead of skipping it
# (host_tools_test.go), so a cached pass never stands for an executor that
# could not run it. Go and the release formula come in hermetically.

# The CI and Bazel policy tests: workflows, the setup-bazel action, .bazelrc,
# MODULE.bazel, every BUILD and .bzl file, tools/bazel and the CI scripts,
# all in //:repo_other_files (every tracked file but Go and Markdown source),
# plus the one Go file whose dolt image pin they compare.
go_test(
    name = "scripts_test",
    srcs = [
        "bazel_autofix_push_test.go",
        "bazel_cache_mode_test.go",
        "bazel_farm_workflow_test.go",
        "bazel_fork_mode_test.go",
        "bazel_hermetic_cc_test.go",
        "bazel_policy_test.go",
        "bazel_rbe_prewarm_test.go",
        "ci_actions_policy_test.go",
        "ci_analytics_workflow_test.go",
        "ci_blacksmith_runner_test.go",
        "ci_f7b_review_test.go",
        "ci_f7c_advisory_test.go",
        "ci_merge_queue_test.go",
        "ci_workflow_apt_get_timeout_test.go",
        "ci_workflow_test.go",
        "embedded_shard_count_test.go",
        "host_tools_test.go",
        "makefile_bazel_primary_test.go",
        "migration_corpus_bazel_test.go",
        "nogo_lint_policy_test.go",
        "pinned_shards_test.go",
        "pr_lanes_bazel_coverage_test.go",
        "pr_risk_bazel_coverage_test.go",
        "rbe_worker_env_test.go",
        "repo_helpers_test.go",
    ],  # keep
    data = [
        "//:repo_other_files",
        "//internal/testutil:testdoltcommon.go",
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
    ],
    # The Go SDK is go.mod's toolchain, whatever go the executor has on PATH.
    env = {"BEADS_TEST_GO": "$(rlocationpath @go_sdk//:bin/go)"},
    deps = [
        "//internal/formula",
        "//internal/testutil/bazeltest",
        "//scripts/internal/testbash",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

