http_archive(
    name = "go_1_25_0_linux_amd64",
    build_file_content = """exports_files(
    ["go/bin/go"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sdk",
    srcs = glob(["go/**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2852af0cb20a13139b3448992e69b868e50ed0f8a1e5940ee1de9e19a123b613",
