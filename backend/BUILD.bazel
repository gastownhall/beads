load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "backend",
    srcs = [
        "backend.go",
        "errors.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/backend",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/storage",
        "//internal/storage/backends",
        "//internal/types",
    ],
)

go_test(
    name = "backend_test",
    srcs = [
        "completeness_test.go",
        "errors_test.go",
    ],
    data = [":go_srcs"],
    deps = [
        ":backend",
        "//backend/conformance",
        "//internal/storage",
        "//internal/testutil/bazeltest",
    ],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---
