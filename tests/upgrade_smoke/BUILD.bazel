load(":defs.bzl", "upgrade_smoke_tests")

# The upgrade smoke tests (formerly cross-version-smoke.yml): one target per
# previous release, upgrade_smoke_<release>_test, running
# scripts/upgrade-smoke-test.sh <release> from the pinned release
# (@bd_releases, sha256-verified against the release catalog) to the
# non-race bd_for_tests. The releases are the newest `window` the catalog
# pins a linux/amd64 asset for (its stable GitHub releases), so a release
# added to the catalog joins the window and the oldest drops out. The PR-core
# lane (bazel-test) runs them remotely on every PR, merge group and push, and
# a target re-runs only when the candidate, the script or its release
# changes.
#
# Tags:
#   pr-core-only: shell tests against the release-shaped bd_for_tests (no
#     integration tag); the integration lane, which requires Go testcases,
#     leaves them out.
upgrade_smoke_tests(
    tags = ["pr-core-only"],
    window = 30,
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

