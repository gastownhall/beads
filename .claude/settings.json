        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mol-attach-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ]
