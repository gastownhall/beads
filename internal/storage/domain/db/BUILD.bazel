# db_test as the retired "Test (storage domain + uow)" job ran it, on the
# dolt-server lane: TestDomainDB's server is a `dolt sql-server` the test
# process starts itself (the local backend of internal/testutil) instead of a
# testcontainers container. GOMAXPROCS=4 is the job's runner shape (the
# executor may have far more cores).
#
# Tags:
#   dolt-server: starts hermetic dolt sql-servers from the pinned dolt in the
#     test wrapper's runfiles (BEADS_TEST_DOLT_SERVER=local); excluded from
#     --config=prcore/ci, selected by --config=doltserver. Runs remotely: no
#     docker, and a missing server fails (REQUIRE=1) instead of skipping, so
#     a cached pass is as good as a fresh one.
sh_test(
    name = "db_dolt_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :db_test)"],
    data = [":db_test"],
    env = {
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        "GOMAXPROCS": "4",
    },
    tags = ["dolt-server"],
)

