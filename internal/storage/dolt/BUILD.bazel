# dolt_test without the race detector: PR Risk's server-Dolt jobs run
# build-embedded's /tmp/dolt-conformance-test, built by `go test -c` with the
# integration and gms_pure_go tags but without -race. tools/bazel/race.bzl lands
# its deps in the configuration the non-race //cmd/bd:bd_for_tests is built
# in; under --config=doltserver-integration (the integration lane's build
# flags) that is the configuration --config=integration builds bd_for_tests
# in, so the server tier compiles no third copy of the graph.
#
# Tags:
#   manual: only the dolt_server_* variants' input, never a build target of
#     its own.
go_test_race_off(
    name = "dolt_race_off",
    tags = ["manual"],
    test = ":dolt_test",
)

# PR Risk's "Test (Server Dolt Conformance)" job: conformance.RunAll against
# server-mode Dolt, with the job's binary flags. TestMain's server is a local
# `dolt sql-server` started from the pinned dolt in the test wrapper's
# runfiles instead of the job's container, and a server that cannot start
# fails the target (BEADS_TEST_REQUIRE_DOLT_CONTAINER=1) instead of skipping
# the suite. It repeats dolt_test's `env` (it has none).
#
# Tags:
#   dolt-server-integration: starts hermetic dolt sql-servers and needs the
#     integration build tag; excluded from --config=prcore/ci and
#     --config=integration, selected by --config=doltserver-integration.
sh_test(
    name = "dolt_server_conformance_test",
    size = "large",
    # The job's -test.timeout=15m fires (with a goroutine dump) well before
    # Bazel's 1200s action limit (eternal under the lane's --test_timeout).
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = [
        "$(rootpath :dolt_race_off)",
        "-test.v",
        "-test.count=1",
        "-test.timeout=15m",
        "-test.run=^TestConformance$$",
    ],
    data = [":dolt_race_off"],
    env = {
        "BEADS_TEST_DOLT_SERVER": "local",
        # The job's "Configure Git" global identity (tools/bazel/test_env.sh).
        "BEADS_TEST_GIT_IDENTITY": "1",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        # The 4-vCPU runner shape: -test.parallel defaults to GOMAXPROCS.
        "GOMAXPROCS": "4",
    },
    tags = ["dolt-server-integration"],
)

# PR Risk's "Test (Server Dolt Full Suite N/16)" jobs: shard k runs
# .github/scripts/server-storage-test-shard.sh k+1 16 (every top-level test
# but TestConformance, assigned by the committed manifest) against
# dolt_race_off, with the jobs' BEADS_TEST_ENV_RUN_DOLT=1 and a local dolt
# sql-server as in dolt_server_conformance_test. SubprocessRunner's helper
# processes re-exec this same binary (BEADS_TEST_SUBPROCESS_BINARY) where the
# job compiles the package again with `go test -tags integration -c`; go.mod
# lets integration.ModuleRoot find the module root it no longer builds in.
# shard_count must stay equal to the manifest's shard total.
#
# Tags:
#   dolt-server-integration: as dolt_server_conformance_test.
sh_test(
    name = "dolt_server_full_test",
    size = "large",
    # The script's -test.timeout=15m fires before Bazel's 1200s limit.
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_manifest_shard.sh"],
    args = [
        "$(rootpath //:.github/scripts/server-storage-test-shard.sh)",
        "BEADS_TEST_SERVER_TEST_BINARY",
        "$(rootpath :dolt_race_off)",
    ],
    data = [
        ":dolt_race_off",
        ":go_srcs",
        "//:.github/scripts/server-storage-test-shard.sh",
        "//:.github/scripts/server-storage-test-shards.txt",
        "//:go.mod",
    ],
    env = {
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_ENV_RUN_DOLT": "1",
        "BEADS_TEST_GIT_IDENTITY": "1",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        "BEADS_TEST_SUBPROCESS_BINARY": "$(rlocationpath :dolt_race_off)",
        "GOMAXPROCS": "4",
    },
    shard_count = 16,
    tags = ["dolt-server-integration"],
)

