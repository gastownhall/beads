# The container-backed uow tests as pr.yml's "Test (storage domain + uow)" job
# runs them (no -short; each test starts its own dolt sql-server container),
# with BEADS_TEST_REQUIRE_DOLT_CONTAINER=1 so a missing container fails instead
# of skipping. It repeats uow_test's `env` (go_test_variant.sh cannot inherit
# it). uow_test itself stays untagged: under --config=prcore those tests skip.
#
# Tags:
#   requires-docker: needs a docker daemon; excluded from --config=prcore/ci,
#     selected by --config=docker.
#   no-remote-exec: the daemon is on the host, not on remote workers.
sh_test(
    name = "uow_docker_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :uow_test)"],
    data = [
        ":uow_test",
        "//cmd/bd:bd_for_tests",
    ],
    # Pinned to the container backend (the docker lane is the A/B control);
    # rule env beats --test_env, so =local on the command line cannot flip it.
    env = {
        "BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)",
        "BEADS_TEST_DOLT_SERVER": "container",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
    },
    # ~12 min unsharded under -race on a loaded host (large allows 15).
    shard_count = 4,
    tags = [
        "no-remote-exec",
        "requires-docker",
    ],
)

# uow_test as pr.yml's "Test (storage domain + uow)" job runs it (no -short),
# on the dolt-server lane: every server the tests ask internal/testutil for is
# a `dolt sql-server` child of the test process, so the target runs on remote
# workers. It repeats uow_test's `env` (go_test_variant.sh cannot inherit it).
# GOMAXPROCS=4 is the job's runner shape. uow_docker_test is the A/B control.
# 8 shards keep each under ~2 min remotely (the package is ~7 min in the job).
#
# Tags:
#   dolt-server: starts hermetic dolt sql-servers from the pinned dolt in the
#     test wrapper's runfiles (BEADS_TEST_DOLT_SERVER=local); excluded from
#     --config=prcore/ci, selected by --config=doltserver. Runs remotely: no
#     docker, and a missing server fails (REQUIRE=1) instead of skipping, so
#     a cached pass is as good as a fresh one.
sh_test(
    name = "uow_dolt_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :uow_test)"],
    data = [
        ":uow_test",
        "//cmd/bd:bd_for_tests",
    ],
    env = {
        "BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)",
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        "GOMAXPROCS": "4",
    },
    shard_count = 8,
    tags = ["dolt-server"],
)

