load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "unsupportedgen_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/internal/storage/unsupportedgen",
    visibility = ["//visibility:private"],
    deps = ["//internal/storage"],
)

go_binary(
    name = "unsupportedgen",
    embed = [":unsupportedgen_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "unsupportedgen_test",
    srcs = ["main_test.go"],
    data = ["//internal/httpclient:go_srcs"],
    embed = [":unsupportedgen_lib"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

