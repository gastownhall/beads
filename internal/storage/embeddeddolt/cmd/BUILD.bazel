load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/internal/storage/embeddeddolt/cmd",
    visibility = ["//visibility:private"],
    deps = ["//internal/storage/embeddeddolt"],
)

# main.go is //go:build cgo: without cgo the package is empty, which
# `go build ./...` skips and a go_binary cannot link. cgo-only: left out of
# //tools/bazel:release_cross (tools/bazel/go_srcs.py).
go_binary(
    name = "cmd",
    embed = [":cmd_lib"],
    tags = ["cgo-only"],
    target_compatible_with = select({
        "//tools/bazel:pure": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//:__subpackages__"],
)

# The same tool built without the race detector whatever the configuration,
# for //cmd/bd:bd_embedded_test's schema template: run once per shard, it
# migrates an empty database in seconds instead of the ~20s it takes under
# --config=embedded's race. cgo-only, as :cmd.
go_binary(
    name = "cmd_norace",
    testonly = True,
    out = "cmd_norace/schema",
    embed = [":cmd_lib"],
    race = "off",
    tags = ["cgo-only"],
    target_compatible_with = select({
        "//tools/bazel:pure": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//cmd/bd:__pkg__"],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
