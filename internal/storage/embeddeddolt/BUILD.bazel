# Runs 15 Bazel shards against every top-level Test* function in
# internal/storage/embeddeddolt/*_test.go but TestConformance, assigned by
# the manifest's 15-shard block (duration-balanced; see
# scripts/ci/embedded_storage_test_durations.json), with
# BEADS_TEST_EMBEDDED_DOLT=1; the wrapper points
# BEADS_TEST_EMBEDDED_TEST_BINARY at this binary, which the concurrency test
# re-executes. This is a *different* shard count from PR Risk's legacy
# fork/push jobs, "Test (Embedded Dolt Storage N/5)" (pr-risk.yml,
# main.yml): those keep running 5 shards of their own, frozen hand-assigned
# block in the same manifest file — shard k here is not the same split as
# their shard k. shard_count must stay equal to this lane's manifest
# block's shard total.
#
# Tags:
#   embedded: the embedded-Dolt tier; excluded from --config=prcore/ci,
#     selected by --config=embedded.
sh_test(
    name = "embeddeddolt_embedded_test",
    size = "large",
    # The script gives the binary the job's -test.timeout=20m, as long as
    # Bazel's 1200s action limit (eternal under --config=embedded), which
    # starts earlier and kills without a goroutine dump (rules_go's wrapper
    # ignores the SIGTERM). The trailing -test.timeout=19m overrides it (the
    # last flag wins) so Go's own timeout fires first and dumps to test.log.
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_manifest_shard.sh"],
    args = [
        "$(rootpath //:.github/scripts/embedded-storage-test-shard.sh)",
        "BEADS_TEST_EMBEDDED_TEST_BINARY",
        "$(rootpath :embeddeddolt_test)",
        "-test.timeout=19m",
    ],
    data = [
        ":embeddeddolt_test",
        ":go_srcs",
        "//:.github/scripts/embedded-storage-test-shard.sh",
        "//:.github/scripts/embedded-storage-test-shards.txt",
    ],
    env = {"BEADS_TEST_EMBEDDED_DOLT": "1"},
    shard_count = 15,
    tags = ["embedded"],
)

# PR Risk's "Test (Embedded Dolt Conformance - core)" job: conformance.RunAll
# except its Audit group, with the job's binary flags but -test.timeout.
#
# Tags:
#   embedded: the embedded-Dolt tier; excluded from --config=prcore/ci,
#     selected by --config=embedded.
sh_test(
    name = "embeddeddolt_conformance_core_test",
    size = "large",
    # Deviation from the job's -test.timeout=30m: Bazel ends the action at
    # 1200s (eternal under --config=embedded), and rules_go's wrapper ignores
    # that SIGTERM, so a hang would end as a bare TIMEOUT. 19m lets Go's own
    # timeout fire first and dump every goroutine to test.log.
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = [
        "$(rootpath :embeddeddolt_test)",
        "-test.v",
        "-test.count=1",
        "-test.timeout=19m",
        "-test.run=^TestConformance$$",
        "-test.skip=^TestConformance$$/^Audit$$",
    ],
    data = [":embeddeddolt_test"],
    env = {"BEADS_TEST_EMBEDDED_DOLT": "1"},
    tags = ["embedded"],
)

# PR Risk's "Test (Embedded Dolt Conformance - audit)" job: the Audit group of
# conformance.RunAll alone, with the same -test.timeout deviation as core.
#
# Tags:
#   embedded: the embedded-Dolt tier; excluded from --config=prcore/ci,
#     selected by --config=embedded.
sh_test(
    name = "embeddeddolt_conformance_audit_test",
    size = "large",
    # Deviation from the job's -test.timeout=30m: Bazel ends the action at
    # 1200s (eternal under --config=embedded), and rules_go's wrapper ignores
    # that SIGTERM, so a hang would end as a bare TIMEOUT. 19m lets Go's own
    # timeout fire first and dump every goroutine to test.log.
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = [
        "$(rootpath :embeddeddolt_test)",
        "-test.v",
        "-test.count=1",
        "-test.timeout=19m",
        "-test.run=^TestConformance$$/^Audit$$",
    ],
    data = [":embeddeddolt_test"],
    env = {"BEADS_TEST_EMBEDDED_DOLT": "1"},
    tags = ["embedded"],
)

