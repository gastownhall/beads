        "proxy.go",
        "read_status.go",
        "server.go",
        "shutdown.go",
        "stats.go",
        "unverified_process_darwin.go",
        "unverified_process_linux.go",
        "unverified_process_unsupported.go",
        "unverified_process_windows.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/storage/dbproxy/proxy",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/atomicfile",
        "//internal/configfile",
        "//internal/debug",
        "//internal/fdhygiene",
        "//internal/lockfile",
