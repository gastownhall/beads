        "//internal/procid",
        "//internal/storage/dbproxy/identity",
        "//internal/storage/dbproxy/pidfile",
        "//internal/storage/dbproxy/server",
        "//internal/storage/dbproxy/util",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
