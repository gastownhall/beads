load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "util",
    srcs = [
        "dsn.go",
        "flock.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/storage/dbproxy/util",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/lockfile",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

go_test(
    name = "util_test",
    srcs = ["dsn_test.go"],
    embed = [":util"],
    deps = ["@com_github_go_sql_driver_mysql//:mysql"],
)

