load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "util",
    srcs = [
        "dsn.go",
        "flock.go",
        "flock_removal_other.go",
        "flock_removal_windows.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/storage/dbproxy/util",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/lockfile",
        "@com_github_go_sql_driver_mysql//:mysql",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "util_test",
    srcs = [
        "dsn_test.go",
        "flock_removal_windows_test.go",
    ],
    embed = [":util"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//internal/lockfile",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

