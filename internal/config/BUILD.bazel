        "repos_test.go",
        "sync_test.go",
        "testmain_test.go",
        "user_config_path_test.go",
        "user_config_path_windows_test.go",
        "worktree_config_test.go",
        "yaml_config_test.go",
        "yaml_nested_roundtrip_test.go",
        "yaml_unset_newline_test.go",
    ],
    embed = [":config"],
    deps = [
        "//internal/git",
        "//internal/gitenv",
        "@com_github_spf13_viper//:viper",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
