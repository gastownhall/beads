load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = [
        "agent_profile.go",
        "config.go",
        "permissions.go",
        "permissions_open_linux.go",
        "permissions_open_nonlinux.go",
        "permissions_windows.go",
        "repos.go",
        "sync.go",
        "user_config_path.go",
        "yaml_config.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/config",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/debug",
        "//internal/gitenv",
        "@com_github_spf13_viper//:viper",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

