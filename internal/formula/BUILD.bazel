load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "formula",
    srcs = [
        "advice.go",
        "condition.go",
        "controlflow.go",
        "expand.go",
        "parser.go",
        "range.go",
        "schema.go",
        "schema_gen.go",
        "stepcondition.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/formula",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/git",
        "@com_github_burntsushi_toml//:toml",
    ],
)

go_test(
    name = "formula_test",
    srcs = [
        "advice_test.go",
        "condition_test.go",
        "controlflow_test.go",
        "expand_test.go",
        "intent_test.go",
        "parser_test.go",
        "range_test.go",
        "schema_gen_test.go",
        "schema_test.go",
        "stepcondition_test.go",
        "validation_sentinel_test.go",
    ],
    data = [
        "schema_gen.go",
        "types.go",
    ],
    embed = [":formula"],
    deps = [
        "//internal/beads",
        "//internal/formula/schemagen",
        "//internal/git",
        "//internal/testutil",
        "//internal/testutil/bazeltest",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
