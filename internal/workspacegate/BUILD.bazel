load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workspacegate",
    srcs = [
        "canon.go",
        "canon_other.go",
        "canon_windows.go",
        "gate.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/workspacegate",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/lockfile",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "workspacegate_test",
    srcs = [
        "canon_other_test.go",
        "canon_test.go",
        "gate_test.go",
        "gate_windows_test.go",
        "readonly_wait_test.go",
    ],
    embed = [":workspacegate"],
    deps = [
        "//internal/testutil/bazeltest",
    ] + select({
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

