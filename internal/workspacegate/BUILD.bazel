load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workspacegate",
    srcs = ["gate.go"],
    importpath = "github.com/steveyegge/beads/internal/workspacegate",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/lockfile"],
)

go_test(
    name = "workspacegate_test",
    srcs = ["gate_test.go"],
    embed = [":workspacegate"],
    deps = ["//internal/testutil/bazeltest"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
