load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wire",
    srcs = [
        "client.go",
        "credential.go",
        "doc.go",
        "handshake.go",
        "paths.go",
        "problem.go",
        "revision_tolerance.go",
        "stream.go",
        "writes.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/httpclient/wire",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/httpapi/apigen",
        "//issueops",
        "@org_golang_x_net//http/httpguts",
    ],
)

go_test(
    name = "wire_test",
    srcs = [
        "client_test.go",
        "credential_source_test.go",
        "credential_test.go",
        "handshake_test.go",
        "handshake_wire_revision_test.go",
        "helpers_test.go",
        "paths_test.go",
        "problem_test.go",
        "problem_wire_revision_test.go",
        "project_stamp_test.go",
        "revision_tolerance_test.go",
        "skew_test.go",
        "stream_test.go",
        "vocabulary_test.go",
        "writes_batch_cap_test.go",
        "writes_twospeed_test.go",
    ],
    data = [
        "//cmd/bd:go_srcs",
        "//internal/httpapi/wireshape:testdata/golden.json",
        "//internal/httpclient:go_srcs",
    ] + glob(["*.go"]),
    embed = [":wire"],
    deps = [
        "//internal/httpapi",
        "//internal/httpapi/apigen",
        "//internal/httpapi/spec",
        "//internal/httpclient/encode",
        "//internal/storage",
        "//internal/types",
        "//issueops",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
