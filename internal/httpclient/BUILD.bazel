# scripts/conformance.sh's Tier 3, the served HTTP corpus: the whole package
# with BEADS_TEST_EMBEDDED_DOLT=1, so the served_*_test.go cases stand a real
# `bd serve` handler over embedded Dolt instead of skipping as they do in
# httpclient_test above, and BEADS_HTTP_TEST_REQUIRED=1, so a missing engine
# fails each served case rather than skipping it. It is the script's run on
# the lane's race build (raceEnabled shrinks its one large apply).
#
# Shard count: on the lane's executors (rbe-west, 2026-10-09, the whole
# embedded lane running) the package is ~750 top-level tests and ~1,100
# test-seconds, all serial, the heaviest about 52s. Each served case copies
# one per-process template workspace instead of initializing its own embedded
# Dolt schema (served_harness_test.go's servedTemplateWorkspace), and
# TestServedBatchGetterContract seeds its 1000 issues in one write: before
# both, the package was ~3,700 test-seconds over 24 shards, the heaviest shard
# 390s. rules_go's round-robin alone (16 shards) left shards at 40-119s,
# wherever its split dropped the long tests, so the tests measured at >= 3s
# (the maximum over three whole-lane runs) are pinned
# (tools/bazel/go_test_pinned_shard.sh, served_pinned_shards.txt from
# tools/bazel/pin_shards.py --shards 17 --min-seconds 3) onto 17 shards, and
# the binary's round-robin deals the other ~650 (~340s of measured test
# time; those shards ran ~1.4x their tests' summed times) over the remaining
# 9.
# Regenerate the manifest from runs of the lane:
#   bazel test //... --config=embedded
#   python3 tools/bazel/pin_shards.py --shards 17 --min-seconds 3 \
#       --write internal/httpclient/served_pinned_shards.txt \
#       bazel-testlogs/internal/httpclient/httpclient_served_test
#
# Tags:
#   embedded: the embedded-Dolt tier; excluded from --config=prcore/ci,
#     selected by --config=embedded.
sh_test(
    name = "httpclient_served_test",
    size = "large",
    # Deviation from the script's -timeout=40m: Bazel ends the action at
    # 1200s (eternal under --config=embedded), and rules_go's wrapper ignores
    # that SIGTERM, so a hang would end as a bare TIMEOUT. 19m lets Go's own
    # timeout fire first and dump every goroutine to test.log.
    timeout = "eternal",
    srcs = ["//tools/bazel:go_test_pinned_shard.sh"],
    args = [
        "$(rootpath :served_pinned_shards.txt)",
        "$(rootpath :httpclient_test)",
        "-test.v",
        "-test.count=1",
        "-test.timeout=19m",
    ],
    data = [
        "served_pinned_shards.txt",
        ":httpclient_test",
    ],
    env = {
        "BEADS_HTTP_TEST_REQUIRED": "1",
        "BEADS_TEST_EMBEDDED_DOLT": "1",
    },
    shard_count = 26,
    tags = ["embedded"],
)

# The served write-role contracts through `bd serve`'s production Provider arm
# (C6 of the bringup test plan). BEADS_HTTP_SERVED_SOURCE=provider makes
# newServedEnvExpecting serve httpapi.Config{Provider: ...} the way
# cmd/bd/serve.go builds it for a server-mode workspace, so every request
# builds its roles through httpapi's per-request timedProvider -> externaldeps
# -> doltSQLProvider -> a //cmd/bd:bd_for_tests db-proxy-child -> a local dolt
# sql-server (served_provider_source_test.go). serve refuses the
# Roles-arm-over-embedded composition httpclient_served_test runs, so this is
# the only served run of the arm production uses. It repeats tests
# httpclient_served_test runs in full on the roles source.
#
# The curated -test.run is pinned in scripts/pr_risk_bazel_coverage_test.go
# (extraRunVariants), and the env in scripts/served_provider_lane_test.go.
# Every test it selects must reach its server through newServedEnv or
# newServedEnvExpecting, never composition() or embeddeddolt.Open, which stay
# on the Roles arm whatever the source; served_source_scan_test.go enforces it
# (servedProviderCuratedRun there must equal the -test.run below).
# -test.timeout=14m fires before the 900s large-test kill, so a hang dumps
# every goroutine. Each case bootstraps its own database (CREATE DATABASE and
# the migration chain), which is most of its cost; rules_go deals every
# top-level test of the package round-robin over the 6 shards before
# -test.run applies, so each shard runs about a sixth of the curated set.
#
# Its 6 shards are 6 of the dolt-race union's one-wave test actions
# (scripts/bazel_dolt_race_test.go bazelDoltRaceTestActions; the union's
# --jobs=70 in .bazelrc pays for them).
#
# Tags:
#   dolt-server: starts hermetic dolt sql-servers from the pinned dolt in the
#     test wrapper's runfiles (BEADS_TEST_DOLT_SERVER=local); excluded from
#     --config=prcore/ci, selected by --config=doltserver. Runs remotely: no
#     docker, and a missing server fails (REQUIRE=1) instead of skipping, so
#     a cached pass is as good as a fresh one.
sh_test(
    name = "httpclient_served_provider_test",
    size = "large",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = [
        "$(rootpath :httpclient_test)",
        "-test.v",
        "-test.count=1",
        "-test.timeout=14m",
        "-test.run=^(TestServedDeleter|TestServedLifecycle|TestServedMetadataCAS|TestServedClaimer|TestServedReleaser|TestServedReadyClaimer|TestServedBatchCloser|TestServedTierServesFromTheSourceItNames)",
    ],
    data = [
        ":httpclient_test",
        "//cmd/bd:bd_for_tests",
    ],
    env = {
        "BEADS_HTTP_SERVED_SOURCE": "provider",
        "BEADS_HTTP_TEST_REQUIRED": "1",
        "BEADS_TEST_BD_BINARY": "$(rlocationpath //cmd/bd:bd_for_tests)",
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
        "GOMAXPROCS": "4",
    },
    shard_count = 6,
    tags = ["dolt-server"],
)

