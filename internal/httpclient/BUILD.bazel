    name = "httpclient",
    srcs = [
        "backend_credential.go",
        "ca.go",
        "ca_permissions_other.go",
        "ca_permissions_unix.go",
        "credential.go",
        "target.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/httpclient",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/configfile",
        "//internal/creds",
        "//internal/httpclient/wire",
        "//internal/storage/backends",
        "@org_golang_x_net//http/httpproxy",
        "@org_golang_x_net//idna",
