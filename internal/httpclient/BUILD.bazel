go_test(
    name = "httpclient_test",
    # Unsharded, this package takes ~350s under --config=ci (BEADS_TEST_SKIP=dolt, no
    # BEADS_TEST_EMBEDDED_DOLT): mostly wall-clock wait on the CA tests' dialer/keep-alive
    # timeouts, not CPU. The go_test default size (medium, 300s timeout) leaves no margin
    # and times out intermittently; size=large/timeout=long follows the same convention as
    # //internal/storage/embeddeddolt's go_test.
    size = "large",
    timeout = "long",
    srcs = [
        "backend_credential_test.go",
        "batchapplier_test.go",
        "brief_test.go",
        "bulk_roles_test.go",
        "ca_permissions_unix_test.go",
        "ca_test.go",
        "ca_wrong_ca_test.go",
        "completeness_test.go",
        "composition_test.go",
        "counts_test.go",
        "credential_source_test.go",
        "credential_test.go",
        "dial_test.go",
        "dispatch_test.go",
        "divergence_citation_gate_test.go",
        "divergence_test.go",
        "helpers_test.go",
        "lifecycle_create_test.go",
        "lifecycle_update_test.go",
        "list_sort_test.go",
        "metadatacas_test.go",
        "roles_graph_cycles_test.go",
        "roles_test.go",
        "served_batch_apply_test.go",
        "served_batch_close_test.go",
        "served_batch_getter_test.go",
        "served_bridge_test.go",
        "served_bulk_test.go",
        "served_claim_lifecycle_test.go",
        "served_commenter_test.go",
        "served_config_test.go",
        "served_config_write_test.go",
        "served_counter_test.go",
        "served_detail_reads_test.go",
        "served_dualrun_test.go",
        "served_graph_aux_test.go",
        "served_graph_counter_test.go",
        "served_harness_test.go",
        "served_hooks_test.go",
        "served_issue_operations_test.go",
        "served_journal_test.go",
        "served_lifecycle_create_test.go",
        "served_list_test.go",
        "served_memories_deps_test.go",
        "served_metadata_cas_test.go",
        "served_project_swap_test.go",
        "served_querier_test.go",
        "served_reader_test.go",
        "served_ready_claimer_test.go",
        "served_readycounter_test.go",
        "served_relations_test.go",
        "served_releaser_test.go",
        "served_test.go",
        "served_wrong_server_test.go",
        "store_dependent_test.go",
        "store_test.go",
        "target_test.go",
        "watch_test.go",
        "wave2b_roles_test.go",
        "wave2c_claimnext_test.go",
        "wave2c_config_test.go",
        "wave2c_journal_test.go",
        "write_ledger_test.go",
        "write_roles_test.go",
    ],
    # keep
    #
    # TestInterfaceCompleteness (completeness_test.go) reads its own package's
    # generated shell, unsupported_gen.go, by a plain relative os.ReadFile to
    # regex-match the methods storage.DoltStorage's refusing shell covers. That
    # file is already a `srcs` member of :httpclient above, which Bazel compiles
    # away rather than leaving as a readable file in the test's sandbox; `data`
    # is what actually puts a copy there, exactly as
    # //internal/httpclient/encode's own go_test does for the same reason.
    # Gazelle does not manage `data` on this rule, so this survives
    # `make bazel-sync` (the directive just says so).
    data = glob(["*.go"]),
    embed = [":httpclient"],
    deps = [
        "//backend/conformance",
        "//internal/eventsjournal",
        "//internal/hooks",
        "//internal/httpapi",
        "//internal/httpapi/apigen",
        "//internal/httpapi/spec",
        "//internal/httpclient/encode",
        "//internal/httpclient/wire",
        "//internal/storage",
        "//internal/storage/backends",
        "//internal/storage/domain",
        "//internal/storage/embeddeddolt",
        "//internal/storage/issueops",
        "//internal/storage/sqlbuild",
        "//internal/types",
        "//internal/workapi",
        "//issueops",
        "//journalops",
        "//memoryops",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# --- begin go_srcs (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
)

# --- end go_srcs ---

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
