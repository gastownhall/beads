load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "jira",
    srcs = [
        "client.go",
        "fieldmapper.go",
        "refs.go",
        "tracker.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/jira",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/debug",
        "//internal/tracker",
        "//internal/types",
    ],
)

go_test(
    name = "jira_test",
    srcs = [
        "client_test.go",
        "refs_test.go",
        "retry_test.go",
        "tracker_test.go",
    ],
    embed = [":jira"],
    deps = [
        "//internal/config",
        "//internal/storage",
        "//internal/tracker",
        "//internal/types",
        "//issueops",
        "//memoryops",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
