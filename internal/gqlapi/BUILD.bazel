load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gqlapi",
    srcs = [
        "gqlapi.go",
        "resolvers.go",
    ],
    embedsrcs = ["schema.graphqls"],
    importpath = "github.com/steveyegge/beads/internal/gqlapi",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/types",
        "//issueops",
        "@com_github_graph_gophers_graphql_go//:graphql-go",
    ],
)

go_test(
    name = "gqlapi_test",
    srcs = ["gqlapi_test.go"],
    embed = [":gqlapi"],
    deps = [
        "//internal/types",
        "//internal/workapi",
        "//issueops",
        "@com_github_graph_gophers_graphql_go//:graphql-go",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

