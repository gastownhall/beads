load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gendigest_lib",
    srcs = ["main.go"],
    importpath = "github.com/steveyegge/beads/internal/httpapi/wireshape/cmd/gendigest",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/httpapi",
        "//internal/httpapi/wireshape",
    ],
)

go_binary(
    name = "gendigest",
    embed = [":gendigest_lib"],
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "gendigest_test",
    srcs = ["main_test.go"],
    embed = [":gendigest_lib"],
    deps = ["//internal/httpapi/wireshape"],
)
