load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wireshape",
    srcs = [
        "doc.go",
        "wireshape.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/httpapi/wireshape",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/httpapi/spec",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "wireshape_test",
    srcs = [
        "wireshape_internal_test.go",
        "wireshape_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":wireshape"],
    deps = ["//internal/httpapi"],
)

# //internal/httpclient/wire:wire_test's revision-tolerance coverage test
# (TestRevisionBearingResponseCoversEveryWireShapeSchemaWithARevisionMember)
# derives the set of schemas a legacy pre-#6053 server's bare-integer
# `revision` can appear on directly from this committed golden digest, so it
# must be readable as data under `bazel test`.
exports_files(
    ["testdata/golden.json"],
    visibility = ["//internal/httpclient/wire:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
