load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wireshape",
    srcs = [
        "doc.go",
        "wireshape.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/httpapi/wireshape",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/httpapi/spec",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "wireshape_test",
    srcs = ["wireshape_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":wireshape",
        "//internal/httpapi",
    ],
)
