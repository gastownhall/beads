load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "apigen",
    srcs = [
        "doc.go",
        "types.gen.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/httpapi/apigen",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/eventsjournal",
        "//internal/types",
        "//issueops",
    ],
)

# //scripts/repochecks:types_gen_drift_test regenerates types.gen.go from the
# spec (`make api-check`'s drift half).
exports_files(
    ["types.gen.go"],
    visibility = ["//scripts/repochecks:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
