load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "validation",
    srcs = [
        "bead.go",
        "issue.go",
        "template.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/validation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/types",
        "//internal/utils",
    ],
)

go_test(
    name = "validation_test",
    srcs = [
        "bead_test.go",
        "issue_test.go",
        "template_lint_sections_test.go",
        "template_test.go",
    ],
    embed = [":validation"],
    deps = [
        "//internal/config",
        "//internal/types",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
