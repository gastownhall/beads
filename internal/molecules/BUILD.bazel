load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "molecules",
    srcs = ["molecules.go"],
    importpath = "github.com/steveyegge/beads/internal/molecules",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/debug",
        "//internal/storage",
        "//internal/types",
    ],
)

go_test(
    name = "molecules_test",
    srcs = [
        "molecules_test.go",
        "testmain_test.go",
    ],
    embed = [":molecules"],
    deps = [
        "//internal/storage",
        "//internal/storage/dolt",
        "//internal/testutil",
        "//internal/types",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
