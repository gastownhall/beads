load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "routing",
    srcs = ["routing.go"],
    importpath = "github.com/steveyegge/beads/internal/routing",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/git",
        "//internal/gitenv",
    ],
)

go_test(
    name = "routing_test",
    srcs = ["routing_test.go"],
    embed = [":routing"],
    deps = [
        "//internal/git",
        "//internal/gitenv",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
