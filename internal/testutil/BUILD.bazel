# testutil_test on the dolt-server lane: the package's own tests of the
# test-server backends, with the local backend selected and required, so
# TestDoltServerFingerprint's local half (formerly pr.yml's "Test (Dolt
# server fingerprint)" job, every PR) and the TestLocalDoltServer_* tests run
# against the pinned dolt in the test wrapper's runfiles. Every other
# configuration of testutil_test passes BEADS_TEST_SKIP=dolt and skips them.
# The container half needs docker and the image, so no Bazel target runs it:
# it runs under plain `go test` (the container backend is the default there)
# on a host that has both, and TestPinnedDoltCLIMatchesContainerImage
# (//scripts) keeps the image tag on the pinned release.
#
# Tags:
#   dolt-server: starts hermetic dolt sql-servers from the pinned dolt in the
#     test wrapper's runfiles (BEADS_TEST_DOLT_SERVER=local); excluded from
#     --config=prcore/ci, selected by --config=doltserver.
sh_test(
    name = "testutil_dolt_test",
    size = "medium",
    srcs = ["//tools/bazel:go_test_variant.sh"],
    args = ["$(rootpath :testutil_test)"],
    data = [":testutil_test"],
    env = {
        "BEADS_TEST_DOLT_SERVER": "local",
        "BEADS_TEST_REQUIRE_DOLT_CONTAINER": "1",
    },
    tags = ["dolt-server"],
)

# The pinned dolt sql-server image, read by //scripts:scripts_test (the CI
# pins agree) and //test/docsync (the docs' pin agrees).
exports_files(
    ["testdoltcommon.go"],
    visibility = [
        "//scripts:__pkg__",
        "//test/docsync:__pkg__",
    ],
)

