load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "github",
    srcs = [
        "client.go",
        "errors.go",
        "fieldmapper.go",
        "links.go",
        "mapping.go",
        "tracker.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/github",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/tracker",
        "//internal/types",
    ],
)

go_test(
    name = "github_test",
    srcs = [
        "client_ratelimit_test.go",
        "links_pagination_test.go",
        "links_test.go",
        "mapping_test.go",
        "push_dedup_test.go",
        "review_fixes_test.go",
        "tracker_test.go",
        "types_test.go",
    ],
    embed = [":github"],
    deps = [
        "//internal/config",
        "//internal/tracker",
        "//internal/types",
    ],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
