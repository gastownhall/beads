load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "docsync_test",
    srcs = [
        "agentfiles_test.go",
        "docsync_test.go",
        "doltpin_test.go",
        "init_safety_recovery_test.go",
    ],
    # The checkout as Bazel sees it: the docs trees, every link target, and
    # every AGENTS.md and test file the agent-instruction checks resolve.
    data = ["//:repo_files"],
    deps = ["//internal/testutil/bazeltest"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__pkg__"],
)

# --- end repo_files ---
