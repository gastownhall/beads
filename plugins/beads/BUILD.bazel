load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "beads",
    srcs = ["copilot_manifest.go"],
    embedsrcs = [".copilot-plugin/plugin.json"],
    importpath = "github.com/steveyegge/beads/plugins/beads",
    visibility = ["//visibility:public"],
)

# Plugin manifests and skill commands checked by //cmd/bd/setup layout tests.
filegroup(
    name = "plugin_files",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*.go",
        ],
    ),
    visibility = ["//cmd/bd/setup:__pkg__"],
)

# Plugin manifests gated by //internal/versioncheck's releaseSources table,
# aggregated into //:release_metadata_files.
exports_files(
    [
        ".claude-plugin/plugin.json",
        ".codex-plugin/plugin.json",
        ".copilot-plugin/plugin.json",
    ],
    visibility = ["//:__pkg__"],
)
