load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "beads",
    srcs = ["copilot_manifest.go"],
    embedsrcs = [".copilot-plugin/plugin.json"],
    importpath = "github.com/steveyegge/beads/plugins/beads",
    visibility = ["//visibility:public"],
)

# Plugin manifests and skill commands checked by //cmd/bd/setup layout tests.
filegroup(
    name = "plugin_files",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*.go",
        ],
    ),
    visibility = ["//cmd/bd/setup:__pkg__"],
)

# Plugin manifests gated by //internal/versioncheck's releaseSources table,
# aggregated into //:release_metadata_files.
exports_files(
    [
        ".claude-plugin/plugin.json",
        ".codex-plugin/plugin.json",
        ".copilot-plugin/plugin.json",
    ],
    visibility = ["//:__pkg__"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
