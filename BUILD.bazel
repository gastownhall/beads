load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/steveyegge/beads
# gazelle drops files whose build constraints name a tag it does not know.
# integration is listed so the `//go:build integration` test files (and
# //internal/testutil/integration) are in srcs and deps; rules_go filters them
# out of every build except --config=integration (.bazelrc), which sets the tag.
# gazelle:build_tags gms_pure_go,integration
# integrations/ holds no Go; it stays visible to Bazel (not in .bazelignore)
# so //:repo_files covers it for //test/docsync's link checks and the
# repository-policy tests in //scripts.
# gazelle:exclude integrations
# The two example Go modules (own go.mod, built against a released beads) are
# not part of this build either, but they are tracked files the repository
# guards (gofmt, build-tag and install-guidance checks in
# //scripts/repochecks) must see, so they are not in .bazelignore.
# gazelle:exclude examples/library-usage
# gazelle:exclude examples/bd-example-extension-go
gazelle(name = "gazelle")

exports_files(
    [".buildflags"],
    visibility = [
        "//scripts:__pkg__",
        "//scripts/prlintmake:__pkg__",
        "//tests/upgrade_smoke:__pkg__",
    ],
)

exports_files([
    "go.mod",
    "go.sum",
])

# The golangci-lint configuration nogo applies (//tools/nogo), and its test.
# //test/docsync checks the agent instructions' links to it.
exports_files(
    [".golangci.yml"],
    visibility = [
        "//test/docsync:__pkg__",
        "//tools/nogo:__pkg__",
        "//tools/nogo/internal/golangci:__pkg__",
    ],
)

# Repository files read by source-scanning tests, declared as their `data` so
# the tests run under `bazel test` and remote execution.
exports_files(
    [".gitattributes"],
    visibility = ["//scripts/gitattributespolicy:__pkg__"],
)

# //tests/hook_timeout_backends: the tracked git hooks whose managed section
# it runs against real timeout implementations. //scripts:shell_scripts_test
# runs pre-push's suite dispatch.
exports_files(
    [
        ".githooks/post-checkout",
        ".githooks/post-merge",
        ".githooks/pre-commit",
        ".githooks/pre-push",
        ".githooks/prepare-commit-msg",
    ],
    visibility = [
        "//scripts:__pkg__",
        "//tests/hook_timeout_backends:__pkg__",
    ],
)

# //scripts:shell_scripts_test: scripts/test.sh's skip list.
exports_files(
    [".test-skip"],
    visibility = ["//scripts:__pkg__"],
)

# The nested Go modules' go.mod files, which mark where the root module ends:
# //scripts:go_test_sources_test's scan of every _test.go file skips their
# trees, as `go test ./...` does. (go.mod is in no Go partition below: it is
# in //:repo_other_files.)
filegroup(
    name = "nested_go_modules",
    srcs = [
        "examples/bd-example-extension-go/go.mod",
        "examples/library-usage/go.mod",
        "//tools/nogo:go.mod",
    ],
    visibility = ["//scripts:__pkg__"],
)

# //scripts/repochecks:winget_portable_alias_test: the winget manifests.
filegroup(
    name = "winget_manifests",
    srcs = glob(["winget/**"]),
    visibility = ["//scripts/repochecks:__pkg__"],
)

# //test/docsync: the repository files outside its Markdown and Go-test
# partitions that the docs and agent instructions link to by path. A new link
# to a file not listed here fails docsync_test under Bazel; add the file.
exports_files(
    [
        ".github/workflows/bazel.yml",
        "beads.go",
        "docs/docs.json",
    ],
    visibility = ["//test/docsync:__pkg__"],
)

# //cmd/bd:bd_test: tracked git hooks (generator parity) and the formula
# primitive fixtures.
filegroup(
    name = "bd_test_files",
    srcs = glob([
        ".githooks/*",
        "examples/formulas/primitives/**",
    ]),
    visibility = ["//cmd/bd:__pkg__"],
)

exports_files(
    [".claude-plugin/marketplace.json"],
    visibility = ["//cmd/bd/setup:__pkg__"],
)

# PR Risk's manifest-sharded tiers' shard scripts and their committed
# manifests (embedded-Dolt cmd and storage, proxied-server cmd, server-Dolt
# storage). The variants (//cmd/bd:bd_embedded_test, //cmd/bd:bd_proxied_test,
# //internal/storage/embeddeddolt:embeddeddolt_embedded_test,
# //internal/storage/dolt:dolt_server_full_test) run them through
# tools/bazel/go_test_manifest_shard.sh, so each Bazel shard runs exactly the
# tests of the CI job with the same shard number. //scripts:go_test_sources_test
# checks the manifests and scripts against the tests they shard.
exports_files(
    [
        ".github/scripts/embedded-cmd-test-shards.txt",
        ".github/scripts/embedded-storage-test-shard.sh",
        ".github/scripts/embedded-storage-test-shards.txt",
        ".github/scripts/embedded-test-shard.sh",
        ".github/scripts/proxied-cmd-test-shards.txt",
        ".github/scripts/proxied-test-shard.sh",
        ".github/scripts/server-storage-test-shard.sh",
        ".github/scripts/server-storage-test-shards.txt",
    ],
    visibility = [
        "//cmd/bd:__pkg__",
        "//internal/storage/dolt:__pkg__",
        "//internal/storage/embeddeddolt:__pkg__",
        "//scripts:__pkg__",
    ],
)

# //internal/versioncheck and //scripts/check-versions release-gate tests: the
# metadata surfaces versioncheck.releaseSources gates, plus the canonical
# version it compares them against and the tracked git hooks whose version
# markers it checks.
#
# Hand-listed rather than globbed because releaseSources is itself a closed
# list: a newly gated surface must be added here too, and until it is the test
# fails under Bazel (it passes under `go test`, which sees the whole checkout).
filegroup(
    name = "release_metadata_files",
    srcs = [
        ".claude-plugin/marketplace.json",
        "integrations/beads-mcp/pyproject.toml",
        "integrations/beads-mcp/src/beads_mcp/__init__.py",
        "integrations/beads-mcp/uv.lock",
        "npm-package/package.json",
        "//cmd/bd:version.go",
        "//cmd/bd:winres/manifest.xml",
        "//cmd/bd:winres/winres.json",
        "//plugins/beads:.claude-plugin/plugin.json",
        "//plugins/beads:.codex-plugin/plugin.json",
        "//plugins/beads:.copilot-plugin/plugin.json",
    ] + glob([".githooks/*"]),
    visibility = [
        "//internal/versioncheck:__pkg__",
        "//scripts/check-versions:__pkg__",
    ],
)

go_library(
    name = "beads",
    srcs = [
        "beads.go",
        "beads_cgo.go",
        "beads_nocgo.go",
        "claim.go",
    ],
    importpath = "github.com/steveyegge/beads",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/beads",
        "//internal/configfile",
        "//internal/doltserver",
        "//internal/storage",
        "//internal/storage/backends",
