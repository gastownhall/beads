# //internal/httpclient/encode:encode_test regenerates and compares the shipped
# divergence ledger doc (TestDivergenceLedgerDocMatchesLedger), so the doc must
# be readable as data under `bazel test`. docsync_files above globs it too, but
# that filegroup's visibility is scoped to //test/docsync alone.
exports_files(
    ["engdocs/design/http-divergence-ledger.md"],
    visibility = ["//internal/httpclient/encode:__pkg__"],
)

