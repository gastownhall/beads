load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:prefix github.com/steveyegge/beads
# gazelle:build_tags gms_pure_go
gazelle(name = "gazelle")

exports_files([
    "go.mod",
    "go.sum",
])

# Inputs of the Bazel policy tests in //scripts (bazel_policy_test.go), so they
# run under `bazel test` as well as `go test`.
filegroup(
    name = "bazel_policy_files",
    srcs = [
        ".bazelrc",
        ".bazelversion",
        ".gitignore",
        "BUILD.bazel",
        "MODULE.bazel",
        "go.mod",
    ],
    visibility = ["//scripts:__pkg__"],
)

go_library(
    name = "beads",
    srcs = [
        "beads.go",
        "beads_cgo.go",
        "beads_nocgo.go",
        "claim.go",
    ],
    importpath = "github.com/steveyegge/beads",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/beads",
        "//internal/configfile",
        "//internal/doltserver",
        "//internal/storage",
        "//internal/storage/backends",
        "//internal/storage/dolt",
        "//internal/storage/domain",
        "//internal/storage/embeddeddolt",
        "//internal/storage/schema",
        "//internal/types",
        "//internal/workspacegate",
    ],
)

go_test(
    name = "beads_test",
    srcs = [
        "beads_gated_test.go",
        "beads_test.go",
        "claim_roundtrip_test.go",
        "claim_test.go",
        "errors_test.go",
        "export_dependency_add_options_test.go",
        "issue_lifecycle_external_test.go",
        "issue_roles_external_test.go",
        "open_backend_selection_test.go",
        "open_nocgo_test.go",
        "query_interfaces_cgo_test.go",
        "query_interfaces_test.go",
    ],
    embed = [":beads"],
    deps = [
        "//internal/hooks",
        "//internal/storage",
        "//internal/storage/backends",
        "//internal/storage/dolt",
        "//internal/storage/domain",
        "//internal/storage/embeddeddolt",
        "//internal/telemetry",
        "//internal/testutil",
        "//internal/types",
        "//internal/workspacegate",
        "//issueops",
    ],
)
