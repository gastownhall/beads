      $done = waitpid $pid, 0;
      alarm 0;
      exit 142 if $sent;
      exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
    ' -- "$_bd_timeout" bd hooks run prepare-commit-msg "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  else
    echo >&2 "beads: hook 'prepare-commit-msg' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    if bd hooks run prepare-commit-msg "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  fi
  if { [ "$_bd_timeout_backend" = coreutils ] && [ "$_bd_exit" -eq 124 ]; } || { [ "$_bd_timeout_backend" = perl ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo >&2 "beads: hook 'prepare-commit-msg' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
else
  # bd is missing from PATH (GH#6751): run the chained gate ourselves so
  # a foreign prepare-commit-msg.old still decides the git operation. The sibling
  # path comes from $0 (no PATH lookup), and a chain that is missing or not
  # executable stays a silent no-op, like the Go-side chain runner.
  case "$0" in
    */*) _bd_chain="${0%/*}/prepare-commit-msg.old" ;;
    *) _bd_chain="./prepare-commit-msg.old" ;;
  esac
  if [ -f "$_bd_chain" ] && [ -x "$_bd_chain" ]; then
    # A chain that is itself a beads hook would call us back (GH#843,
    # GH#1120), so classify readable chains the way the Go-side guard
    # does and leave those alone. The marker literals are built from
    # adjacent quoted strings so this section never embeds them intact;
    # an unreadable executable is attempted rather than assumed ours.
    _bd_chain_foreign=1
    if [ -r "$_bd_chain" ]; then
      _bd_p_begin='# --- BEGIN BEADS'' INTEGRATION'
      _bd_p_inline='# bd ''(beads)'
      _bd_p_shim='# bd''-shim'
      _bd_p_version='# bd-hooks''-version: '
      _bd_p_run='bd hooks'' run'
      _bd_w='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_'
      while IFS= read -r _bd_line || [ -n "$_bd_line" ]; do
        case "$_bd_line" in
          *"$_bd_p_begin"*|*"$_bd_p_shim"*|*"$_bd_p_inline"*|"$_bd_p_version"*) _bd_chain_foreign=0; break ;;
          "$_bd_p_run"|"$_bd_p_run"[!$_bd_w]*|*[!$_bd_w]"$_bd_p_run"|*[!$_bd_w]"$_bd_p_run"[!$_bd_w]*) _bd_chain_foreign=0; break ;;
        esac
      done < "$_bd_chain"
    fi
    if [ "$_bd_chain_foreign" -eq 1 ]; then
      export BD_GIT_HOOK=1
      if "$_bd_chain" "$@"; then
        :
      else
        _bd_exit=$?
        exit "$_bd_exit"
      fi
    fi
  fi
fi
