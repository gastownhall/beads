#!/usr/bin/env bash
# Pre-commit hook: auto-format with gofmt, then lint and vet with nogo.
# Installed via: git config core.hooksPath .githooks
# See also: make install (sets hooksPath automatically)

set -euo pipefail

# Only check staged Go files (Added, Copied, Modified). No early exit here:
# the beads section at the bottom must run for non-Go commits too.
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go_files" ]; then
    # Auto-format and re-stage, through the go.mod-pinned gofmt. A bare PATH
    # gofmt belongs to the host toolchain, and on a host newer than the go
    # directive it rewrites and re-stages files into a form CI's gofmt rejects
    # -- silently, on every Go commit. See scripts/ci/gofmt-bin.sh.
    gofmt_bin="$(./scripts/ci/gofmt-bin.sh)"
    echo "$staged_go_files" | xargs "$gofmt_bin" -w
    echo "$staged_go_files" | xargs git add

    # Lint and vet: nogo (//tools/nogo) over the staged files' Bazel packages,
    # the analyzers bazel.yml gates on (go test's vet checks plus the
    # golangci-lint linters .golangci.yml enables). Findings fail the commit;
    # nogo prints a `patch -p1` command for the ones with suggested fixes.
    # Needs bazel (or bazelisk) on PATH; the windows/darwin passes run in CI
    # and in `make lint`.
    make lint-changed LINT_CHANGED_SCOPE=staged || exit 1
fi

# --- BEGIN BEADS INTEGRATION v1.3.4 ---
# This section is managed by beads. Do not remove these markers.
_bd_exit=0
_bd_missing=0
_bd_deadline=0
_bd_chain=
_bd_chain_foreign=0
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  case "$_bd_timeout" in
    *[!0-9]*|'') _bd_timeout_invalid=1 ;;
    *[1-9]*) _bd_timeout_invalid=0 ;;
    *) _bd_timeout_invalid=1 ;;
  esac
  if [ "$_bd_timeout_invalid" -eq 1 ]; then
    echo >&2 "beads: invalid BEADS_HOOK_TIMEOUT; using 300 seconds"
    _bd_timeout=300
  fi
  _bd_timeout_backend=none
  _bd_timeout_command=
  for _bd_timeout_candidate in timeout gtimeout; do
    if command -v "$_bd_timeout_candidate" >/dev/null 2>&1; then
      if _bd_timeout_version="$("$_bd_timeout_candidate" --version 2>/dev/null)"; then
        case "$_bd_timeout_version" in
          "timeout (GNU coreutils) "*|"timeout (uutils coreutils) "*) _bd_timeout_command=$_bd_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_bd_timeout_command" ]; then
    _bd_timeout_backend=coreutils
    if "$_bd_timeout_command" -- "$_bd_timeout" bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _bd_timeout_backend=perl
    if perl -e '
      my $t = shift;
      my $pid = fork;
      defined $pid or die "beads: fork failed: $!\n";
      if (!$pid) { setpgrp(0, 0); exec { $ARGV[0] } @ARGV; warn "beads: cannot run $ARGV[0]: $!\n"; exit 127 }
      my ($sig, $sent, $done) = ("TERM", 0, 0);
      $SIG{ALRM} = sub { return if $done; kill $sig, -$pid; ($sig, $sent) = ("KILL", 1); alarm 2 };
      $SIG{$_} = sub { kill $_[0], -$pid unless $done } for qw(HUP INT TERM);
      alarm $t;
      $done = waitpid $pid, 0;
      alarm 0;
      exit 142 if $sent;
      exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
    ' -- "$_bd_timeout" bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    if bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  fi
  if { [ "$_bd_timeout_backend" = coreutils ] && [ "$_bd_exit" -eq 124 ]; } || { [ "$_bd_timeout_backend" = perl ] && [ "$_bd_exit" -eq 142 ]; }; then
    _bd_deadline=1
  fi
else
  _bd_missing=1
fi
if [ "$_bd_missing" -eq 1 ] || [ "$_bd_deadline" -eq 1 ]; then
  # The chained sibling gate, resolved from $0 (no PATH lookup), still
  # decides the git operation when bd is missing (GH#6751), and after a
  # recognized deadline its unknown result must not be assumed. A
  # chain that is missing or not executable stays a silent no-op,
  # like the Go-side chain runner.
  case "$0" in
    */*) _bd_chain="${0%/*}/pre-commit.old" ;;
    *) _bd_chain="./pre-commit.old" ;;
  esac
  if [ -f "$_bd_chain" ] && [ -x "$_bd_chain" ]; then
    # A chain that is itself a beads hook would call us back (GH#843,
    # GH#1120), so classify readable chains the way the Go-side guard
    # does and leave those alone. The marker literals are built from
    # adjacent quoted strings so this section never embeds them intact;
    # an unreadable executable is attempted rather than assumed ours.
    _bd_chain_foreign=1
    if [ -r "$_bd_chain" ]; then
      _bd_p_begin='# --- BEGIN BEADS'' INTEGRATION'
      _bd_p_inline='# bd ''(beads)'
      _bd_p_shim='# bd''-shim'
      _bd_p_version='# bd-hooks''-version: '
      _bd_p_run='bd hooks'' run'
      _bd_w='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_'
      while IFS= read -r _bd_line || [ -n "$_bd_line" ]; do
        case "$_bd_line" in
          *"$_bd_p_begin"*|*"$_bd_p_shim"*|*"$_bd_p_inline"*|"$_bd_p_version"*) _bd_chain_foreign=0; break ;;
          "$_bd_p_run"|"$_bd_p_run"[!$_bd_w]*|*[!$_bd_w]"$_bd_p_run"|*[!$_bd_w]"$_bd_p_run"[!$_bd_w]*) _bd_chain_foreign=0; break ;;
        esac
      done < "$_bd_chain"
    fi
  fi
fi
if [ "$_bd_deadline" -eq 1 ]; then
  if [ "$_bd_chain_foreign" -eq 1 ]; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s with chained gate 'pre-commit.old' present; its result is not known — refusing. Raise BEADS_HOOK_TIMEOUT or use --no-verify to skip this gate."
    exit "$_bd_exit"
  fi
  echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
  _bd_exit=0
elif [ "$_bd_missing" -eq 1 ] && [ "$_bd_chain_foreign" -eq 1 ]; then
  # bd is missing from PATH (GH#6751): run the chained gate ourselves
  # so a foreign pre-commit.old still decides the git operation.
  export BD_GIT_HOOK=1
  if "$_bd_chain" "$@"; then
    :
  else
    _bd_exit=$?
  fi
fi
if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
# --- END BEADS INTEGRATION v1.3.4 ---
